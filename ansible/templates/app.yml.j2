apiVersion: v1
kind: ServiceAccount
metadata:
  name: hello
  namespace: {{ app_namespace }}
automountServiceAccountToken: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hello
  namespace: {{ app_namespace }}
spec:
  replicas: 2
  revisionHistoryLimit: 2
  strategy:
    rollingUpdate:
      maxSurge: 0
      maxUnavailable: 1
  selector:
    matchLabels:
      app: hello
  template:
    metadata:
      labels:
        app: hello
    spec:
      serviceAccountName: hello
      automountServiceAccountToken: false
      enableServiceLinks: false
      terminationGracePeriodSeconds: 20
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app: hello
      containers:
        - name: hello
          image: {{ infra.image_name }}@{{ image_digest.stdout }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests: {cpu: 10m, memory: 16Mi}
            limits: {cpu: 100m, memory: 64Mi}
          readinessProbe:
            httpGet: {path: /healthz, port: http}
            initialDelaySeconds: 2
            periodSeconds: 5
          livenessProbe:
            httpGet: {path: /healthz, port: http}
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: hello
  namespace: {{ app_namespace }}
spec:
  type: ClusterIP
  selector:
    app: hello
  ports:
    - name: http
      port: 80
      targetPort: http
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: hello-isolation
  namespace: {{ app_namespace }}
spec:
  podSelector:
    matchLabels:
      app: hello
  policyTypes: [Ingress, Egress]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: ingress-system
          podSelector:
            matchLabels:
              app.kubernetes.io/name: traefik
      ports:
        - protocol: TCP
          port: 8080
  egress: []
{% for env, server in [('staging', 'https://acme-staging-v02.api.letsencrypt.org/directory'), ('production', 'https://acme-v02.api.letsencrypt.org/directory')] %}
---
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: letsencrypt-{{ env }}
  namespace: {{ app_namespace }}
spec:
  acme:
    email: {{ acme_email }}
    server: {{ server }}
    privateKeySecretRef:
      name: letsencrypt-{{ env }}-account
    solvers:
      - http01:
          ingress:
            ingressClassName: traefik
            podTemplate:
              spec:
                resources:
                  requests: {cpu: 10m, memory: 32Mi}
                  limits: {cpu: 100m, memory: 64Mi}
{% endfor %}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: hello-{{ acme_environment }}
  namespace: {{ app_namespace }}
spec:
  secretName: hello-{{ acme_environment }}-tls
  dnsNames: [{{ hostname }}]
  issuerRef:
    name: letsencrypt-{{ acme_environment }}
    kind: Issuer
  privateKey:
    algorithm: ECDSA
    size: 256
    rotationPolicy: Always
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: https-redirect
  namespace: {{ app_namespace }}
spec:
  redirectScheme:
    scheme: https
    permanent: true
---
# Redirect only the app route, not cert-manager's separate HTTP-01 solver route.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: hello-http
  namespace: {{ app_namespace }}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
    traefik.ingress.kubernetes.io/router.middlewares: {{ app_namespace }}-https-redirect@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
    - host: {{ hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: hello
                port: {number: 80}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: hello-https
  namespace: {{ app_namespace }}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: traefik
  tls:
    - hosts: [{{ hostname }}]
      secretName: hello-{{ acme_environment }}-tls
  rules:
    - host: {{ hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: hello
                port: {number: 80}
